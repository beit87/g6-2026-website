  "params": [
    {
      "bind": {
        "input": "radio",
        "name": "Visualizzazione: ",
        "options": [
          "Valori assoluti",
          "Valori normalizzati"
        ]
      },
      "name": "view_mode_n_nations",
      "value": "Valori assoluti"
    }
  ],
  "title": "Clustering sport, Nazioni partecipanti nel tempo",
  "transform": [
    {
      "as": "valore_plot",
      "calculate": "view_mode_n_nations == 'Valori normalizzati' ? datum.n_nations_norm : datum.n_nations"
    }
  ],
  "width": "container"
}